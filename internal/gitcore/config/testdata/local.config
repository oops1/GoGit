[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
	autocrlf = input
[user]
	name = Валерий Чукалин
	email = oops1.vc@gmail.com
[remote "origin"]
	url = https://example.com/a.git
	fetch = +refs/heads/*:refs/remotes/origin/*
	fetch = +refs/pull/*/head:refs/remotes/origin/pull/*
[remote "upstream"]
	url = git@example.com:b.git
	fetch = +refs/heads/*:refs/remotes/upstream/*
	pushurl = ssh://push.example.com/b.git
[branch "main"]
	remote = origin
	merge = refs/heads/main
	rebase = true
[branch "feature/x"]
	remote = origin
[alias]
	lg = log --oneline --graph
[safe]
	directory = /srv/a
	directory = /srv/b
[include]
	path = shared.config
[includeIf "gitdir:/srv/work/**"]
	path = work.config
[includeIf "onbranch:release/*"]
	path = release.config
[http]
	sslVerify = true
[http "https://example.com"]
	proxy = http://p:8080
[gc]
	auto = 6700
[pack]
	windowMemory = 100m
