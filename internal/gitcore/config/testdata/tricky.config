# leading comment
; semicolon comment

[core] bare = true
[Core "MiXeD"]
	Key = Value
	Key = Second
[a.B]
	x = 1
[quoted]
	spaced = "  keep  "
	tab = a\tb
	nl = a\nb
	bs = a\\b
	dq = a\"b
	back = a\bb
	cont = one\
two
	hash = value # trailing comment
	semi = value ; trailing comment
	inquote = "a;b#c"
	novalue
	empty =
	emptyq = ""
	trail = value   
	joined = a"b"c
[core]
	reopened = yes
[tail]
	last = x