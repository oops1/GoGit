<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="1100" Height="680">

    <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="36"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="36"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="36"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="openLeft" Grid.Column="0" Height="32" VerticalAlignment="Center"
                Content="{Loc Dialog.Compare.OpenLeft}"/>
        <Button x:Name="openRight" Grid.Column="2" Height="32" VerticalAlignment="Center"
                Content="{Loc Dialog.Compare.OpenRight}"/>
        <Button x:Name="save" Grid.Column="4" Height="32" VerticalAlignment="Center"
                Content="{Loc Dialog.Compare.Save}"/>
        <Button x:Name="undo" Grid.Column="6" Height="32" VerticalAlignment="Center"
                Content="{Loc Dialog.Compare.Undo}"/>
        <Button x:Name="redo" Grid.Column="8" Height="32" VerticalAlignment="Center"
                Content="{Loc Dialog.Compare.Redo}"/>
        <Button x:Name="prevChange" Grid.Column="10" Height="32" VerticalAlignment="Center"
                ToolTip="{Loc Dialog.Compare.Prev.Tip}"/>
        <Button x:Name="nextChange" Grid.Column="12" Height="32" VerticalAlignment="Center"
                ToolTip="{Loc Dialog.Compare.Next.Tip}"/>
        <CheckBox x:Name="hideUnchanged" Grid.Column="14" VerticalAlignment="Center"
                  Content="{Loc Dialog.Compare.HideUnchanged}"/>
        <CheckBox x:Name="ignoreWhitespace" Grid.Column="16" VerticalAlignment="Center"
                  Content="{Loc Dialog.Compare.IgnoreWhitespace}"/>
    </Grid>

    <DiffView x:Name="diff" Grid.Row="2" ReadOnlyLeft="False" ReadOnlyRight="False"/>

    <Grid Grid.Row="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="110"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="changeCount" Grid.Column="0" Text="" VerticalAlignment="Center" Height="20"/>
        <TextBlock x:Name="position" Grid.Column="1" Text="" VerticalAlignment="Center" Height="20"/>
        <TextBlock x:Name="message" Grid.Column="2" Text="" VerticalAlignment="Center" Height="20"/>
        <Button x:Name="close" Grid.Column="3" Height="32" VerticalAlignment="Center"
                Content="{Loc Dialog.Compare.Close}"/>
    </Grid>
</Grid>
