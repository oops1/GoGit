<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="440" Height="130">

    <Grid.RowDefinitions>
        <RowDefinition Height="24"/>
        <RowDefinition Height="28"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="30"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="90"/>
    </Grid.ColumnDefinitions>

    <TextBlock x:Name="target" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
               Text=""/>

    <CheckBox x:Name="bypassHooks" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
              Content="{Loc Dialog.Push.BypassHooks}"/>

    <Button x:Name="ok" Grid.Row="3" Grid.Column="1" Margin="0,0,6,0"
            Content="{Loc Dialog.Push.OK}"/>
    <Button x:Name="cancel" Grid.Row="3" Grid.Column="2"
            Content="{Loc Dialog.Push.Cancel}"/>
</Grid>
