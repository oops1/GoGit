<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="520" Height="336">

    <Grid.RowDefinitions>
        <RowDefinition Height="28"/>
        <RowDefinition Height="24"/>
        <RowDefinition Height="14"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="28"/>
        <RowDefinition Height="28"/>
        <RowDefinition Height="14"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="28"/>
        <RowDefinition Height="28"/>
        <RowDefinition Height="28"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="30"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="170"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="90"/>
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Loc Dialog.RepoSettings.Name}"
               VerticalAlignment="Center"/>
    <TextBox x:Name="name" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
             Placeholder="{Loc Dialog.RepoSettings.NamePlaceholder}"/>

    <TextBlock x:Name="path" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text=""
               FontSize="11" VerticalAlignment="Center"/>

    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.RepoSettings.Identity}" FontWeight="Bold"/>

    <TextBlock Grid.Row="4" Grid.Column="0" Text="{Loc Dialog.RepoSettings.UserName}"
               VerticalAlignment="Center"/>
    <TextBox x:Name="userName" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"/>

    <TextBlock Grid.Row="5" Grid.Column="0" Text="{Loc Dialog.RepoSettings.UserEmail}"
               VerticalAlignment="Center"/>
    <TextBox x:Name="userEmail" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"/>

    <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.RepoSettings.Remote}" FontWeight="Bold"/>

    <TextBlock Grid.Row="8" Grid.Column="0" Text="{Loc Dialog.RepoSettings.DefaultRemote}"
               VerticalAlignment="Center"/>
    <ComboBox x:Name="defaultRemote" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2"/>

    <TextBlock Grid.Row="9" Grid.Column="0" Text="{Loc Dialog.RepoSettings.PullStrategy}"
               VerticalAlignment="Center"/>
    <ComboBox x:Name="pullStrategy" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2"/>

    <TextBlock Grid.Row="10" Grid.Column="0" Text="{Loc Dialog.RepoSettings.AutoFetch}"
               VerticalAlignment="Center"/>
    <ComboBox x:Name="autoFetch" Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2"/>

    <TextBlock x:Name="hint" Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="3" Text=""
               FontSize="11"/>

    <Button x:Name="ok" Grid.Row="13" Grid.Column="1" Margin="0,0,6,0"
            Content="{Loc Dialog.RepoSettings.OK}"/>
    <Button x:Name="cancel" Grid.Row="13" Grid.Column="2"
            Content="{Loc Dialog.RepoSettings.Cancel}"/>
</Grid>
