<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="560" Height="222">

    <Grid.RowDefinitions>
        <RowDefinition Height="22"/>
        <RowDefinition Height="36"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="22"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="36"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="30"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="150"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="90"/>
    </Grid.ColumnDefinitions>

    <TextBlock x:Name="header" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Text="" FontWeight="Bold"/>
    <TextBlock x:Name="text" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Text="" TextWrapping="Wrap"/>

    <TextBlock x:Name="nameLabel" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text=""/>
    <TextBox x:Name="name" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"/>
    <TextBlock x:Name="result" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="" FontSize="11"/>
    <TextBlock x:Name="baseLabel" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Text="{Loc Dialog.FlowStart.Base}"/>
    <ComboBox x:Name="base" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3"/>

    <TextBlock x:Name="hint" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4"
               Text="" FontSize="11" TextWrapping="Wrap"/>

    <Button x:Name="ok" Grid.Row="9" Grid.Column="2" Margin="0,0,6,0"
            Content="{Loc Dialog.FlowStart.OK}"/>
    <Button x:Name="cancel" Grid.Row="9" Grid.Column="3"
            Content="{Loc Dialog.FlowStart.Cancel}"/>
</Grid>
