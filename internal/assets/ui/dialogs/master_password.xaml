<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="440" Height="330">

    <Grid.RowDefinitions>
        <RowDefinition Height="52"/>
        <RowDefinition Height="24"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="24"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="24"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="22"/>
        <RowDefinition Height="22"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="40"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="90"/>
        <ColumnDefinition Width="90"/>
    </Grid.ColumnDefinitions>

    <TextBlock x:Name="prompt" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.MasterPassword.PromptSet}" TextWrapping="Wrap"/>

    <TextBlock x:Name="currentLabel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.MasterPassword.Current}"/>
    <PasswordBox x:Name="current" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                 Placeholder="{Loc Dialog.MasterPassword.Current}"/>

    <TextBlock x:Name="passwordLabel" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.MasterPassword.Password}"/>
    <PasswordBox x:Name="password" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                 Placeholder="{Loc Dialog.MasterPassword.Password}"/>

    <TextBlock x:Name="confirmLabel" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.MasterPassword.Confirm}"/>
    <PasswordBox x:Name="confirm" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                 Placeholder="{Loc Dialog.MasterPassword.Confirm}"/>

    <TextBlock x:Name="strength" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"
               Text="" FontSize="11"/>
    <TextBlock x:Name="hint" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3"
               Text="" FontSize="11" Foreground="#E81123" Visibility="Collapsed"/>

    <Button x:Name="ok" Grid.Row="10" Grid.Column="1" Margin="0,0,6,0"
            Content="{Loc Dialog.MasterPassword.OK}"/>
    <Button x:Name="cancel" Grid.Row="10" Grid.Column="2"
            Content="{Loc Dialog.MasterPassword.Cancel}"/>
</Grid>
