<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="480" Height="450">

    <Grid.RowDefinitions>
        <RowDefinition Height="390"/>
        <RowDefinition Height="50"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="90"/>
        <ColumnDefinition Width="90"/>
    </Grid.ColumnDefinitions>

    <TabControl x:Name="tabs" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                Width="480" Height="390" SelectedIndex="0">
        <TabItem Header="{Loc Dialog.Settings.Tab.General}">
            <Grid Width="480" Height="358">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Loc Dialog.Settings.Language}"/>
                <ComboBox x:Name="language" Grid.Row="0" Grid.Column="1"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Loc Dialog.Settings.Theme}"/>
                <ComboBox x:Name="theme" Grid.Row="1" Grid.Column="1">
                    <ComboBoxItem Content="{Loc Theme.System}"/>
                    <ComboBoxItem Content="{Loc Theme.Dark}"/>
                    <ComboBoxItem Content="{Loc Theme.Light}"/>
                </ComboBox>

                <CheckBox x:Name="showToolbar" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                          Content="{Loc Dialog.Settings.ShowToolbar}"/>
                <CheckBox x:Name="showStatusBar" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                          Content="{Loc Dialog.Settings.ShowStatusBar}"/>
                <CheckBox x:Name="toolbarCaptions" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                          Content="{Loc Dialog.Settings.ToolbarCaptions}"/>
                <CheckBox x:Name="journalFullAuthorName" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                          Content="{Loc Dialog.Settings.JournalFullAuthorName}"/>
            </Grid>
        </TabItem>
        <TabItem Header="{Loc Dialog.Settings.Tab.Git}">
            <Grid Width="480" Height="358">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Loc Dialog.Settings.LogMaxCount}"/>
                <NumericUpDown x:Name="logMaxCount" Grid.Row="0" Grid.Column="1"
                                Minimum="50" Maximum="100000" Increment="50"/>

                <CheckBox x:Name="autoFetch" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                          Content="{Loc Dialog.Settings.AutoFetch}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Loc Dialog.Settings.FetchInterval}"/>
                <NumericUpDown x:Name="fetchInterval" Grid.Row="2" Grid.Column="1"
                                Minimum="30" Maximum="3600" Increment="10"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{Loc Dialog.Settings.WorkTreeDepth}"
                           ToolTip="{Loc Dialog.Settings.WorkTreeDepth.Tip}"/>
                <NumericUpDown x:Name="workTreeDepth" Grid.Row="3" Grid.Column="1"
                                ToolTip="{Loc Dialog.Settings.WorkTreeDepth.Tip}"
                                Minimum="0" Maximum="100" Increment="1"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{Loc Dialog.Settings.PullStrategy}"/>
                <TextBox x:Name="pullStrategy" Grid.Row="4" Grid.Column="1"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="{Loc Dialog.Settings.DefaultRemote}"/>
                <TextBox x:Name="defaultRemote" Grid.Row="5" Grid.Column="1"/>

                <CheckBox x:Name="pruneOnFetch" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                          Content="{Loc Dialog.Settings.PruneOnFetch}"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="{Loc Dialog.Settings.ShallowDepth}"/>
                <NumericUpDown x:Name="shallowDepth" Grid.Row="7" Grid.Column="1"
                                Minimum="0" Maximum="100000" Increment="1"/>
            </Grid>
        </TabItem>
        <TabItem Header="{Loc Dialog.Settings.Tab.Credentials}">
            <Grid Width="480" Height="358">
                <Grid.RowDefinitions>
                    <RowDefinition Height="180"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <DataGrid x:Name="credentialsTable" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                          Width="480" Height="180"
                          IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserSortColumns="False" SelectionMode="Single"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Loc Dialog.Settings.Credentials.Resource}"/>
                <TextBox x:Name="credentialResource" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Loc Dialog.Settings.Credentials.User}"/>
                <TextBox x:Name="credentialUsername" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{Loc Dialog.Settings.Credentials.Secret}"/>
                <PasswordBox x:Name="credentialSecret" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                             Placeholder="{Loc Dialog.Settings.Credentials.Secret}"/>

                <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Width="480" Height="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="credentialAdd" Grid.Column="0" Margin="0,0,6,0"
                            Content="{Loc Dialog.Settings.Credentials.Add}"/>
                    <Button x:Name="credentialRemove" Grid.Column="1" Margin="0,0,6,0"
                            Content="{Loc Dialog.Settings.Credentials.Remove}"/>
                    <Button x:Name="credentialMasterPassword" Grid.Column="2" Margin="0,0,6,0"
                            Content="{Loc Dialog.Settings.Credentials.MasterPassword}"/>
                    <Button x:Name="credentialsUnlock" Grid.Column="3"
                            Content="{Loc Dialog.Settings.Secrets.Unlock}"/>
                </Grid>

                <TextBlock x:Name="credentialsStatus" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="" FontSize="11"/>
            </Grid>
        </TabItem>
        <TabItem Header="{Loc Dialog.Settings.Tab.SSH}">
            <Grid Width="480" Height="358">
                <Grid.RowDefinitions>
                    <RowDefinition Height="180"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <DataGrid x:Name="sshTable" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                          Width="480" Height="180"
                          IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserSortColumns="False" SelectionMode="Single"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Loc Dialog.Settings.SSH.Host}"/>
                <TextBox x:Name="sshHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Loc Dialog.Settings.SSH.KeyFile}"/>
                <TextBox x:Name="sshPath" Grid.Row="2" Grid.Column="1"/>
                <Button x:Name="sshBrowse" Grid.Row="2" Grid.Column="2"
                        Content="{Loc Dialog.Settings.SSH.Browse}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{Loc Dialog.Settings.SSH.Passphrase}"/>
                <PasswordBox x:Name="sshPassphrase" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                             Placeholder="{Loc Dialog.Settings.SSH.Passphrase}"/>

                <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Width="480" Height="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="sshAdd" Grid.Column="0" Margin="0,0,6,0"
                            Content="{Loc Dialog.Settings.SSH.Add}"/>
                    <Button x:Name="sshRemove" Grid.Column="1" Margin="0,0,6,0"
                            Content="{Loc Dialog.Settings.SSH.Remove}"/>
                    <Button x:Name="sshUnlock" Grid.Column="2"
                            Content="{Loc Dialog.Settings.Secrets.Unlock}"/>
                </Grid>

                <TextBlock x:Name="sshStatus" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="" FontSize="11"/>
            </Grid>
        </TabItem>
    </TabControl>

    <Button x:Name="ok" Grid.Row="1" Grid.Column="1" Margin="0,0,6,0"
            Content="{Loc Dialog.Settings.OK}"/>
    <Button x:Name="cancel" Grid.Row="1" Grid.Column="2"
            Content="{Loc Dialog.Settings.Cancel}"/>
</Grid>
