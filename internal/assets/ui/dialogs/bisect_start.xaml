<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="560" Height="250">

    <Grid.RowDefinitions>
        <RowDefinition Height="34"/>
        <RowDefinition Height="22"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="22"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="30"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="90"/>
    </Grid.ColumnDefinitions>

    <TextBlock x:Name="header" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.Bisect.Header}" TextWrapping="Wrap"/>

    <TextBlock x:Name="badLabel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.Bisect.BadLabel}"/>
    <ComboBox x:Name="bad" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"/>

    <TextBlock x:Name="goodLabel" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.Bisect.GoodLabel}"/>
    <ComboBox x:Name="good" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"/>

    <TextBlock x:Name="hint" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
               Text="" FontSize="11" TextWrapping="Wrap"/>

    <Button x:Name="ok" Grid.Row="8" Grid.Column="1" Margin="0,0,6,0"
            Content="{Loc Dialog.Bisect.OK}"/>
    <Button x:Name="cancel" Grid.Row="8" Grid.Column="2"
            Content="{Loc Dialog.Bisect.Cancel}"/>
</Grid>
