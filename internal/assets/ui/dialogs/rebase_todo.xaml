<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="620" Height="420">

    <Grid.RowDefinitions>
        <RowDefinition Height="22"/>
        <RowDefinition Height="240"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="30"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="150"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="80"/>
        <ColumnDefinition Width="80"/>
        <ColumnDefinition Width="110"/>
    </Grid.ColumnDefinitions>

    <TextBlock x:Name="ontoLabel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5"
               Text="{Loc Dialog.RebaseTodo.OntoLabel}"/>

    <DataGrid x:Name="steps" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
              Width="620" Height="240"
              IsReadOnly="True" AutoGenerateColumns="False"
              CanUserSortColumns="False" SelectionMode="Single"/>

    <TextBlock x:Name="actionLabel" Grid.Row="3" Grid.Column="0"
               Text="{Loc Dialog.RebaseTodo.ActionLabel}"/>
    <ComboBox x:Name="action" Grid.Row="3" Grid.Column="1" Margin="0,0,6,0"/>
    <Button x:Name="up" Grid.Row="3" Grid.Column="2" Margin="0,0,6,0"
            Content="{Loc Dialog.RebaseTodo.Up}"/>
    <Button x:Name="down" Grid.Row="3" Grid.Column="3"
            Content="{Loc Dialog.RebaseTodo.Down}"/>

    <TextBlock x:Name="hint" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5"
               Text="" FontSize="11" TextWrapping="Wrap"/>

    <Button x:Name="ok" Grid.Row="6" Grid.Column="3" Margin="0,0,6,0"
            Content="{Loc Dialog.RebaseTodo.OK}"/>
    <Button x:Name="cancel" Grid.Row="6" Grid.Column="4"
            Content="{Loc Dialog.RebaseTodo.Cancel}"/>
</Grid>
