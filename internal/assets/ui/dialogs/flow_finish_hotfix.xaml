<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="560" Height="408">

    <Grid.RowDefinitions>
        <RowDefinition Height="22"/>
        <RowDefinition Height="36"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="28"/>
        <RowDefinition Height="100"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="26"/>
        <RowDefinition Height="26"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="26"/>
        <RowDefinition Height="26"/>
        <RowDefinition Height="36"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="30"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="170"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="90"/>
    </Grid.ColumnDefinitions>

    <TextBlock x:Name="header" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Text="" FontWeight="Bold"/>
    <TextBlock x:Name="text" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Text="" TextWrapping="Wrap"/>

    <TextBlock x:Name="messageLabel" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="" VerticalAlignment="Center"/>
    <Button x:Name="selectFromLog" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2"
            Content="{Loc Dialog.FlowFinish.SelectFromLog}"/>
    <TextBox x:Name="message" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4"
             AcceptsReturn="True" TextWrapping="Wrap"/>

    <CheckBox x:Name="fetch" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4" Content=""/>
    <CheckBox x:Name="deleteBranch" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4" Content=""/>
    <CheckBox x:Name="createTag" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center"
              Content="{Loc Dialog.FlowFinish.CreateTag}"/>
    <TextBox x:Name="tagName" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3"/>
    <CheckBox x:Name="mergeDevelop" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="4" Content=""/>
    <CheckBox x:Name="push" Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="4" Content=""/>

    <TextBlock x:Name="hint" Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="4"
               Text="" FontSize="11" TextWrapping="Wrap"/>

    <Button x:Name="ok" Grid.Row="13" Grid.Column="2" Margin="0,0,6,0"
            Content="{Loc Dialog.FlowFinish.OK}"/>
    <Button x:Name="cancel" Grid.Row="13" Grid.Column="3"
            Content="{Loc Dialog.FlowFinish.Cancel}"/>
</Grid>
