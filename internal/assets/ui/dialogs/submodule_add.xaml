<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="560" Height="300">

    <Grid.RowDefinitions>
        <RowDefinition Height="22"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="22"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="22"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="30"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="90"/>
    </Grid.ColumnDefinitions>

    <TextBlock x:Name="urlLabel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.SubmoduleAdd.URLLabel}"/>
    <TextBox x:Name="url" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"/>

    <TextBlock x:Name="pathLabel" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.SubmoduleAdd.PathLabel}"/>
    <TextBox x:Name="path" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"/>

    <TextBlock x:Name="branchLabel" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.SubmoduleAdd.BranchLabel}"/>
    <TextBox x:Name="branch" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"/>

    <TextBlock x:Name="hint" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3"
               Text="" FontSize="11" TextWrapping="Wrap"/>

    <Button x:Name="ok" Grid.Row="11" Grid.Column="1" Margin="0,0,6,0"
            Content="{Loc Dialog.SubmoduleAdd.OK}"/>
    <Button x:Name="cancel" Grid.Row="11" Grid.Column="2"
            Content="{Loc Dialog.SubmoduleAdd.Cancel}"/>
</Grid>
