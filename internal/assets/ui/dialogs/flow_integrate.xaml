<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="520" Height="180">

    <Grid.RowDefinitions>
        <RowDefinition Height="22"/>
        <RowDefinition Height="36"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="26"/>
        <RowDefinition Height="26"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="30"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="90"/>
    </Grid.ColumnDefinitions>

    <TextBlock x:Name="header" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" FontWeight="Bold"
               Text="{Loc Dialog.FlowIntegrate.Header}"/>
    <TextBlock x:Name="text" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Text="" TextWrapping="Wrap"/>

    <RadioButton x:Name="modeMerge" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                 GroupName="flowIntegrateMode" Content="" IsChecked="True"/>
    <RadioButton x:Name="modeRebase" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                 GroupName="flowIntegrateMode" Content=""/>

    <Button x:Name="ok" Grid.Row="6" Grid.Column="1" Margin="0,0,6,0"
            Content="{Loc Dialog.FlowIntegrate.OK}"/>
    <Button x:Name="cancel" Grid.Row="6" Grid.Column="2"
            Content="{Loc Dialog.FlowIntegrate.Cancel}"/>
</Grid>
