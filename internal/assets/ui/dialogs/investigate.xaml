<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="960" Height="640">

    <Grid.RowDefinitions>
        <RowDefinition Height="22"/>
        <RowDefinition Height="220"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="36"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="pathLabel" Grid.Row="0" Text="{Loc Dialog.Investigate.PathLabel}"/>

    <DataGrid x:Name="commits" Grid.Row="1"
              IsReadOnly="True" AutoGenerateColumns="False"
              CanUserSortColumns="False" SelectionMode="Single"/>

    <DiffView x:Name="diff" Grid.Row="3" ReadOnlyLeft="True" ReadOnlyRight="True"
              ShowReadOnlyMark="False"/>

    <Grid Grid.Row="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="110"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="hint" Grid.Column="0" Text="" VerticalAlignment="Center" Height="20"/>
        <Button x:Name="cancel" Grid.Column="2" Height="32" VerticalAlignment="Center"
                Content="{Loc Dialog.Investigate.Cancel}"/>
        <Button x:Name="close" Grid.Column="4" Height="32" VerticalAlignment="Center"
                Content="{Loc Dialog.Investigate.Close}"/>
    </Grid>
</Grid>
