<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="520" Height="200">

    <Grid.RowDefinitions>
        <RowDefinition Height="22"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="22"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="12"/>
        <RowDefinition Height="26"/>
        <RowDefinition Height="26"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="30"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="90"/>
    </Grid.ColumnDefinitions>

    <TextBlock x:Name="scopeLabel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.SaveStash.Scope.All}"/>

    <TextBlock x:Name="messageLabel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.SaveStash.Message}"/>
    <TextBox x:Name="message" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"/>

    <CheckBox x:Name="includeUntracked" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
              Content="{Loc Dialog.SaveStash.IncludeUntracked}"/>
    <CheckBox x:Name="keepIndex" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
              Content="{Loc Dialog.SaveStash.KeepIndex}"/>

    <Button x:Name="ok" Grid.Row="8" Grid.Column="1" Margin="0,0,6,0"
            Content="{Loc Dialog.SaveStash.OK}"/>
    <Button x:Name="cancel" Grid.Row="8" Grid.Column="2"
            Content="{Loc Dialog.Stash.Cancel}"/>
</Grid>
