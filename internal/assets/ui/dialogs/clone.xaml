<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="520" Height="274">

    <Grid.RowDefinitions>
        <RowDefinition Height="24"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="40"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="150"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="90"/>
    </Grid.ColumnDefinitions>

    <TextBlock x:Name="urlLabel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.Clone.URL}"/>
    <TextBox x:Name="url" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"/>

    <TextBlock x:Name="directoryLabel" Grid.Row="2" Grid.Column="0"
               Text="{Loc Dialog.Clone.Directory}"/>
    <TextBox x:Name="directory" Grid.Row="2" Grid.Column="1" Margin="0,0,6,0"/>
    <Button x:Name="browse" Grid.Row="2" Grid.Column="2"
            Content="{Loc Dialog.Clone.Browse}"/>

    <TextBlock x:Name="status" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
               Text="" FontSize="11" Foreground="#999999"/>

    <Button x:Name="check" Grid.Row="4" Grid.Column="2"
            Content="{Loc Dialog.Clone.Check}"/>

    <TextBlock x:Name="branchLabel" Grid.Row="5" Grid.Column="0"
               Text="{Loc Dialog.Clone.Branch}"/>
    <ComboBox x:Name="branch" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"/>

    <CheckBox x:Name="shallow" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
              Content="{Loc Dialog.Clone.Shallow}"/>

    <TextBlock x:Name="depthLabel" Grid.Row="7" Grid.Column="0"
               Text="{Loc Dialog.Clone.Depth}"/>
    <NumericUpDown x:Name="depth" Grid.Row="7" Grid.Column="1"
                    Minimum="0" Maximum="1000000" Increment="1" Value="1"/>

    <Button x:Name="ok" Grid.Row="8" Grid.Column="1" Margin="0,0,6,0"
            Content="{Loc Dialog.Clone.OK}"/>
    <Button x:Name="cancel" Grid.Row="8" Grid.Column="2"
            Content="{Loc Dialog.Clone.Cancel}"/>
</Grid>
