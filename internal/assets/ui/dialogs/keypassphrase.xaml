<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="480" Height="260">

    <Grid.RowDefinitions>
        <RowDefinition Height="24"/>
        <RowDefinition Height="24"/>
        <RowDefinition Height="24"/>
        <RowDefinition Height="24"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="24"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="40"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="90"/>
        <ColumnDefinition Width="90"/>
    </Grid.ColumnDefinitions>

    <TextBlock x:Name="prompt" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.KeyPassphrase.Prompt}"/>
    <TextBlock x:Name="key" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
               Text="" FontWeight="Bold"/>
    <TextBlock x:Name="host" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
               Text=""/>

    <TextBlock x:Name="passphraseLabel" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.KeyPassphrase.Passphrase}"/>
    <PasswordBox x:Name="passphrase" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                 Placeholder="{Loc Dialog.KeyPassphrase.Passphrase}"/>

    <CheckBox x:Name="remember" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
              Content="{Loc Dialog.KeyPassphrase.Remember}"/>

    <TextBlock x:Name="hint" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
               Text="" FontSize="11" Visibility="Collapsed"/>

    <Button x:Name="ok" Grid.Row="8" Grid.Column="1" Margin="0,0,6,0"
            Content="{Loc Dialog.KeyPassphrase.OK}"/>
    <Button x:Name="cancel" Grid.Row="8" Grid.Column="2"
            Content="{Loc Dialog.KeyPassphrase.Cancel}"/>
</Grid>
