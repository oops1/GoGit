<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="1180" Height="720">

    <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="36"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="36"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="36"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="fromHead" Grid.Column="0" Height="32" VerticalAlignment="Center"
                Content="{Loc Dialog.IndexEditor.FromHead}" ToolTip="{Loc Dialog.IndexEditor.FromHead.Tip}"/>
        <Button x:Name="keepIndex" Grid.Column="2" Height="32" VerticalAlignment="Center"
                Content="{Loc Dialog.IndexEditor.KeepIndex}" ToolTip="{Loc Dialog.IndexEditor.KeepIndex.Tip}"/>
        <Button x:Name="fromWorking" Grid.Column="4" Height="32" VerticalAlignment="Center"
                Content="{Loc Dialog.IndexEditor.FromWorking}" ToolTip="{Loc Dialog.IndexEditor.FromWorking.Tip}"/>
        <Button x:Name="prevChange" Grid.Column="6" Height="32" VerticalAlignment="Center"
                ToolTip="{Loc Dialog.IndexEditor.Prev.Tip}"/>
        <Button x:Name="nextChange" Grid.Column="8" Height="32" VerticalAlignment="Center"
                ToolTip="{Loc Dialog.IndexEditor.Next.Tip}"/>
        <Button x:Name="reset" Grid.Column="10" Height="32" VerticalAlignment="Center"
                Content="{Loc Dialog.IndexEditor.Reset}" ToolTip="{Loc Dialog.IndexEditor.Reset.Tip}"/>
    </Grid>

    <MergeView x:Name="merge" Grid.Row="2" ShowBase="True" SyntaxHighlight="True" ReadOnly="False"/>

    <Grid Grid.Row="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="110"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="changes" Grid.Column="0" Text="" VerticalAlignment="Center" Height="20"/>
        <TextBlock x:Name="position" Grid.Column="1" Text="" VerticalAlignment="Center" Height="20"/>
        <TextBlock x:Name="message" Grid.Column="2" Text="" VerticalAlignment="Center" Height="20"/>
        <Button x:Name="save" Grid.Column="3" Height="32" VerticalAlignment="Center"
                Content="{Loc Dialog.IndexEditor.Save}" ToolTip="{Loc Dialog.IndexEditor.Save.Tip}"/>
        <Button x:Name="close" Grid.Column="5" Height="32" VerticalAlignment="Center"
                Content="{Loc Dialog.IndexEditor.Close}"/>
    </Grid>
</Grid>
