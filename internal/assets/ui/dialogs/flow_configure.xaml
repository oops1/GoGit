<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="480" Height="370">

    <Grid.RowDefinitions>
        <RowDefinition Height="30"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="14"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="30"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="90"/>
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{Loc Dialog.FlowConfig.Master}"/>
    <TextBox x:Name="master" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"/>
    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{Loc Dialog.FlowConfig.Develop}"/>
    <TextBox x:Name="develop" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"/>

    <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{Loc Dialog.FlowConfig.Feature}"/>
    <TextBox x:Name="feature" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"/>
    <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="{Loc Dialog.FlowConfig.Release}"/>
    <TextBox x:Name="release" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3"/>
    <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="{Loc Dialog.FlowConfig.Hotfix}"/>
    <TextBox x:Name="hotfix" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3"/>
    <TextBlock Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" Text="{Loc Dialog.FlowConfig.Support}"/>
    <TextBox x:Name="support" Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="3"/>
    <TextBlock Grid.Row="12" Grid.Column="0" VerticalAlignment="Center" Text="{Loc Dialog.FlowConfig.VersionTag}"/>
    <TextBox x:Name="versionTag" Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="3"/>

    <TextBlock x:Name="hint" Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="4"
               Text="" FontSize="11" TextWrapping="Wrap"/>

    <Button x:Name="ok" Grid.Row="16" Grid.Column="2" Margin="0,0,6,0"
            Content="{Loc Dialog.FlowConfig.OK}"/>
    <Button x:Name="cancel" Grid.Row="16" Grid.Column="3"
            Content="{Loc Dialog.FlowConfig.Cancel}"/>
</Grid>
