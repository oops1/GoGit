<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="520" Height="520">

    <Grid.RowDefinitions>
        <RowDefinition Height="22"/>
        <RowDefinition Height="36"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="26"/>
        <RowDefinition Height="26"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="12"/>
        <RowDefinition Height="22"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="36"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="30"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="170"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="90"/>
        <ColumnDefinition Width="90"/>
    </Grid.ColumnDefinitions>

    <TextBlock x:Name="header" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" FontWeight="Bold"
               Text="{Loc Dialog.FlowConfig.Header}"/>
    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" TextWrapping="Wrap"
               Text="{Loc Dialog.FlowConfig.Text}"/>

    <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="{Loc Dialog.FlowConfig.Type}"/>
    <RadioButton x:Name="typeLight" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                 GroupName="flowConfigType" Content="{Loc Dialog.FlowConfig.Light}"/>
    <RadioButton x:Name="typeFull" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                 GroupName="flowConfigType" Content="{Loc Dialog.FlowConfig.Full}" IsChecked="True"/>

    <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="{Loc Dialog.FlowConfig.Develop}"/>
    <TextBox x:Name="develop" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3"/>
    <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="{Loc Dialog.FlowConfig.Master}"/>
    <TextBox x:Name="master" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3"/>
    <TextBlock Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" Text="{Loc Dialog.FlowConfig.Remote}"/>
    <ComboBox x:Name="remote" Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="3"/>

    <TextBlock Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="4" Text="{Loc Dialog.FlowConfig.Prefixes}"/>
    <TextBlock Grid.Row="13" Grid.Column="0" VerticalAlignment="Center" Text="{Loc Dialog.FlowConfig.Feature}"/>
    <TextBox x:Name="feature" Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="3"/>
    <TextBlock Grid.Row="15" Grid.Column="0" VerticalAlignment="Center" Text="{Loc Dialog.FlowConfig.Release}"/>
    <TextBox x:Name="release" Grid.Row="15" Grid.Column="1" Grid.ColumnSpan="3"/>
    <TextBlock Grid.Row="17" Grid.Column="0" VerticalAlignment="Center" Text="{Loc Dialog.FlowConfig.Hotfix}"/>
    <TextBox x:Name="hotfix" Grid.Row="17" Grid.Column="1" Grid.ColumnSpan="3"/>
    <TextBlock Grid.Row="19" Grid.Column="0" VerticalAlignment="Center" Text="{Loc Dialog.FlowConfig.Support}"/>
    <TextBox x:Name="support" Grid.Row="19" Grid.Column="1" Grid.ColumnSpan="3"/>
    <TextBlock Grid.Row="21" Grid.Column="0" VerticalAlignment="Center" Text="{Loc Dialog.FlowConfig.VersionTag}"/>
    <TextBox x:Name="versionTag" Grid.Row="21" Grid.Column="1" Grid.ColumnSpan="3"/>

    <TextBlock x:Name="hint" Grid.Row="22" Grid.Column="0" Grid.ColumnSpan="4"
               Text="" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>

    <Button x:Name="reset" Grid.Row="24" Grid.Column="0" Margin="0,0,6,0"
            Content="{Loc Dialog.FlowConfig.Reset}"/>
    <Button x:Name="ok" Grid.Row="24" Grid.Column="2" Margin="0,0,6,0"
            Content="{Loc Dialog.FlowConfig.OK}"/>
    <Button x:Name="cancel" Grid.Row="24" Grid.Column="3"
            Content="{Loc Dialog.FlowConfig.Cancel}"/>
</Grid>
