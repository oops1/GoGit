<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="460" Height="300">

    <Grid.RowDefinitions>
        <RowDefinition Height="24"/>
        <RowDefinition Height="24"/>
        <RowDefinition Height="24"/>
        <RowDefinition Height="24"/>
        <RowDefinition Height="24"/>
        <RowDefinition Height="24"/>
        <RowDefinition Height="24"/>
        <RowDefinition Height="24"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="40"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="90"/>
        <ColumnDefinition Width="90"/>
    </Grid.ColumnDefinitions>

    <TextBlock x:Name="hostLabel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.HostKey.Host}"/>
    <TextBlock x:Name="host" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
               Text="" FontWeight="Bold"/>

    <TextBlock x:Name="algorithmLabel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.HostKey.Algorithm}"/>
    <TextBlock x:Name="algorithm" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
               Text=""/>

    <TextBlock x:Name="fingerprintLabel" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.HostKey.Fingerprint}"/>
    <TextBlock x:Name="fingerprint" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
               Text="" FontFamily="Consolas"/>

    <TextBlock x:Name="question" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.HostKey.Question}"/>

    <TextBlock x:Name="warning" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"
               Text="" FontSize="11" Foreground="#E81123" Visibility="Collapsed"/>

    <Button x:Name="accept" Grid.Row="9" Grid.Column="1" Margin="0,0,6,0"
            Content="{Loc Dialog.HostKey.Accept}"/>
    <Button x:Name="reject" Grid.Row="9" Grid.Column="2"
            Content="{Loc Dialog.HostKey.Reject}"/>
</Grid>
