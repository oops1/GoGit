<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="520" Height="290">

    <Grid.RowDefinitions>
        <RowDefinition Height="22"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="22"/>
        <RowDefinition Height="100"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="30"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="90"/>
    </Grid.ColumnDefinitions>

    <TextBlock x:Name="nameLabel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.Tag.NameLabel}"/>
    <TextBox x:Name="name" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"/>

    <TextBlock x:Name="messageLabel" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.Tag.MessageLabel}"/>
    <TextBox x:Name="message" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
             AcceptsReturn="True" TextWrapping="Wrap"/>

    <TextBlock x:Name="hint" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
               Text="" FontSize="11" TextWrapping="Wrap"/>

    <Button x:Name="ok" Grid.Row="8" Grid.Column="1" Margin="0,0,6,0"
            Content="{Loc Dialog.Tag.OK}"/>
    <Button x:Name="cancel" Grid.Row="8" Grid.Column="2"
            Content="{Loc Dialog.Tag.Cancel}"/>
</Grid>
