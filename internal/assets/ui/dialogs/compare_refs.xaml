<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="740" Height="460">

    <Grid.RowDefinitions>
        <RowDefinition Height="22"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="22"/>
        <RowDefinition Height="260"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="30"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="110"/>
    </Grid.ColumnDefinitions>

    <TextBlock x:Name="sidesLabel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.CompareRefs.SidesLabel}"/>
    <ComboBox x:Name="left" Grid.Row="1" Grid.Column="0" Margin="0,0,6,0"/>
    <ComboBox x:Name="right" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"/>

    <TextBlock x:Name="countsLabel" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Text=""/>

    <DataGrid x:Name="changes" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
              Width="740" Height="260"
              IsReadOnly="True" AutoGenerateColumns="False"
              CanUserSortColumns="False" SelectionMode="Single"/>

    <TextBlock x:Name="hint" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
               Text="" FontSize="11" TextWrapping="Wrap"/>

    <Button x:Name="close" Grid.Row="7" Grid.Column="2"
            Content="{Loc Dialog.CompareRefs.Close}"/>
</Grid>
