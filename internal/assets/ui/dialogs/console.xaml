<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="820" Height="504">

    <Grid.RowDefinitions>
        <RowDefinition Height="416"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="28"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="30"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="120"/>
        <ColumnDefinition Width="120"/>
    </Grid.ColumnDefinitions>

    <DataGrid x:Name="output" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
              Width="820" Height="416"
              IsReadOnly="True" AutoGenerateColumns="False"
              CanUserSortColumns="False" SelectionMode="Single"/>

    <ConsoleInput x:Name="input" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                  Width="820" Height="28"/>

    <TextBlock x:Name="hint" Grid.Row="4" Grid.Column="0"
               Text="" FontSize="11" TextTrimming="CharacterEllipsis"/>

    <Button x:Name="clear" Grid.Row="4" Grid.Column="1" Margin="0,0,6,0"
            Content="{Loc Dialog.Console.Clear}"/>
    <Button x:Name="close" Grid.Row="4" Grid.Column="2"
            Content="{Loc Dialog.Console.Close}"/>
</Grid>
