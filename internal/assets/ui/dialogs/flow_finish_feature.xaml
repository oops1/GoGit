<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="560" Height="402">

    <Grid.RowDefinitions>
        <RowDefinition Height="22"/>
        <RowDefinition Height="36"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="26"/>
        <RowDefinition Height="26"/>
        <RowDefinition Height="26"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="28"/>
        <RowDefinition Height="100"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="26"/>
        <RowDefinition Height="26"/>
        <RowDefinition Height="36"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="30"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="90"/>
    </Grid.ColumnDefinitions>

    <TextBlock x:Name="header" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="" FontWeight="Bold"/>
    <TextBlock x:Name="text" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Text="" TextWrapping="Wrap"/>

    <RadioButton x:Name="modeMerge" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                 GroupName="flowFinishMode" Content="{Loc Dialog.FlowFinish.MergeCommit}" IsChecked="True"/>
    <RadioButton x:Name="modeSquash" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                 GroupName="flowFinishMode" Content="{Loc Dialog.FlowFinish.Squash}"/>
    <RadioButton x:Name="modeRebase" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                 GroupName="flowFinishMode" Content=""/>

    <TextBlock x:Name="messageLabel" Grid.Row="7" Grid.Column="0" Text="" VerticalAlignment="Center"/>
    <Button x:Name="selectFromLog" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2"
            Content="{Loc Dialog.FlowFinish.SelectFromLog}"/>
    <TextBox x:Name="message" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3"
             AcceptsReturn="True" TextWrapping="Wrap"/>

    <CheckBox x:Name="deleteBranch" Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" Content=""/>
    <CheckBox x:Name="push" Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="3" Content=""/>

    <TextBlock x:Name="hint" Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="3"
               Text="" FontSize="11" TextWrapping="Wrap"/>

    <Button x:Name="ok" Grid.Row="14" Grid.Column="1" Margin="0,0,6,0"
            Content="{Loc Dialog.FlowFinish.OK}"/>
    <Button x:Name="cancel" Grid.Row="14" Grid.Column="2"
            Content="{Loc Dialog.FlowFinish.Cancel}"/>
</Grid>
