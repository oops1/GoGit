<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="sshEditRoot" Width="470" Height="222">

    <Grid.RowDefinitions>
        <RowDefinition Height="30"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="26"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="14"/>
        <RowDefinition Height="18"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="44"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="150"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="150"/>
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Loc Dialog.Settings.SSH.Host}"
               Height="18" VerticalAlignment="Center"/>
    <TextBox x:Name="sshHost" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
             Placeholder="{Loc Dialog.Settings.SSH.Host.Placeholder}"/>

    <CheckBox x:Name="sshUseDefault" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
              FontSize="10" Content="{Loc Dialog.Settings.SSH.UseDefault}"/>

    <TextBlock Grid.Row="4" Grid.Column="0" Text="{Loc Dialog.Settings.SSH.KeyFile}"
               Height="18" VerticalAlignment="Center"/>
    <TextBox x:Name="sshPath" Grid.Row="4" Grid.Column="1"
             Placeholder="{Loc Dialog.Settings.SSH.KeyFile.Placeholder}"/>
    <Button x:Name="sshBrowse" Grid.Row="4" Grid.Column="2" Height="30" Margin="10,0,0,0"
            Content="{Loc Dialog.Settings.SSH.Browse}"/>

    <TextBlock Grid.Row="6" Grid.Column="0" Text="{Loc Dialog.Settings.SSH.Passphrase}"
               Height="18" VerticalAlignment="Center"/>
    <PasswordBox x:Name="sshPassphrase" Grid.Row="6" Grid.Column="1"
                 Placeholder="{Loc Dialog.Settings.SSH.Passphrase.Placeholder}"/>
    <Button x:Name="sshTestConnection" Grid.Row="6" Grid.Column="2" Height="30" Margin="10,0,0,0"
            Content="{Loc Dialog.Settings.SSH.TestConnection}"/>

    <TextBlock x:Name="sshEditStatus" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3"
               Text="" FontSize="11"/>

    <Grid Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="110"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="sshEditCancel" Grid.Column="1" Height="30" Margin="0,0,8,0" VerticalAlignment="Center"
                Content="{Loc Dialog.Settings.Cancel}"/>
        <Button x:Name="sshEditOK" Grid.Column="2" Tag="accent" Height="30" VerticalAlignment="Center"
                Content="{Loc Dialog.Settings.SSH.Save}"/>
    </Grid>
</Grid>
