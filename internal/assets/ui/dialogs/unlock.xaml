<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="420" Height="200">

    <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="24"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="24"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="40"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="90"/>
        <ColumnDefinition Width="90"/>
    </Grid.ColumnDefinitions>

    <TextBlock x:Name="prompt" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.Unlock.Prompt}" TextWrapping="Wrap"/>

    <TextBlock x:Name="passwordLabel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
               Text="{Loc Dialog.Unlock.Password}"/>
    <PasswordBox x:Name="password" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                 Placeholder="{Loc Dialog.Unlock.Password}"/>

    <TextBlock x:Name="hint" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
               Text="" FontSize="11" Foreground="#E81123" Visibility="Collapsed"/>

    <Button x:Name="ok" Grid.Row="5" Grid.Column="1" Margin="0,0,6,0"
            Content="{Loc Dialog.Unlock.OK}"/>
    <Button x:Name="cancel" Grid.Row="5" Grid.Column="2"
            Content="{Loc Dialog.Unlock.Cancel}"/>
</Grid>
