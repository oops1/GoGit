<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="452" Height="316">

    <Grid.RowDefinitions>
        <RowDefinition Height="78"/>
        <RowDefinition Height="18"/>
        <RowDefinition Height="1"/>
        <RowDefinition Height="16"/>
        <RowDefinition Height="22"/>
        <RowDefinition Height="22"/>
        <RowDefinition Height="22"/>
        <RowDefinition Height="22"/>
        <RowDefinition Height="16"/>
        <RowDefinition Height="1"/>
        <RowDefinition Height="16"/>
        <RowDefinition Height="18"/>
        <RowDefinition Height="18"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="32"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="16"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="72"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="130"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="96"/>
    </Grid.ColumnDefinitions>

    <Image x:Name="logo" Grid.Row="0" Grid.Column="0" VerticalAlignment="Top"/>

    <Grid Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="26"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Loc App.Title}" FontSize="17" FontWeight="Bold"/>
        <TextBlock x:Name="tagline" Grid.Row="1" Text="{Loc Dialog.About.Tagline}" FontSize="11"/>
        <TextBlock x:Name="version" Grid.Row="3" Text="" FontSize="11"/>
    </Grid>

    <Separator Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"/>

    <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Text="{Loc Dialog.About.Platform}" FontSize="11"/>
    <TextBlock x:Name="platform" Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2" Text="" FontSize="11"/>

    <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Text="{Loc Dialog.About.Architecture}" FontSize="11"/>
    <TextBlock x:Name="architecture" Grid.Row="5" Grid.Column="3" Grid.ColumnSpan="2" Text="" FontSize="11"/>

    <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Text="{Loc Dialog.About.GitEngine}" FontSize="11"/>
    <TextBlock x:Name="gitEngine" Grid.Row="6" Grid.Column="3" Grid.ColumnSpan="2" Text="" FontSize="11"/>

    <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Text="{Loc Dialog.About.GUI}" FontSize="11"/>
    <TextBlock x:Name="guiEngine" Grid.Row="7" Grid.Column="3" Grid.ColumnSpan="2" Text="" FontSize="11"/>

    <Separator Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="5"/>

    <TextBlock x:Name="summaryFirst" Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="5"
               Text="{Loc Dialog.About.Summary.First}" FontSize="11"/>
    <TextBlock x:Name="summarySecond" Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="5"
               Text="{Loc Dialog.About.Summary.Second}" FontSize="11"/>

    <Grid Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26"/>
            <ColumnDefinition Width="84"/>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="96"/>
        </Grid.ColumnDefinitions>
        <Image x:Name="githubIcon" Grid.Column="0" VerticalAlignment="Center"/>
        <Button x:Name="github" Grid.Column="1" Height="24" VerticalAlignment="Center"
                Content="{Loc Dialog.About.GitHub}"/>
        <Button x:Name="license" Grid.Column="2" Height="24" VerticalAlignment="Center"
                Content="{Loc Dialog.About.License}"/>
        <Button x:Name="ok" Grid.Column="4" Tag="accent" Height="30" VerticalAlignment="Center"
                Content="{Loc Dialog.About.OK}"/>
    </Grid>

    <TextBlock x:Name="copyright" Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="5" Text="" FontSize="10"/>
</Grid>
