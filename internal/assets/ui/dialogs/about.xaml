<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="404" Height="330">

    <Grid.RowDefinitions>
        <RowDefinition Height="80"/>
        <RowDefinition Height="14"/>
        <RowDefinition Height="1"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="96"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="1"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="18"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="14"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="26"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image x:Name="logo" Grid.Column="0" VerticalAlignment="Top"/>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Loc App.Title}" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="tagline" Grid.Row="1" Text="{Loc Dialog.About.Tagline}" FontSize="13"/>
            <TextBlock x:Name="version" Grid.Row="3" Text="" FontSize="13"/>
        </Grid>
    </Grid>

    <Separator Grid.Row="2"/>

    <Grid Grid.Row="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="146"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Loc Dialog.About.Platform}"
                   FontSize="13" Height="20" VerticalAlignment="Center"/>
        <TextBlock x:Name="platform" Grid.Row="0" Grid.Column="1" Text=""
                   FontSize="13" Height="20" VerticalAlignment="Center"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Loc Dialog.About.Architecture}"
                   FontSize="13" Height="20" VerticalAlignment="Center"/>
        <TextBlock x:Name="architecture" Grid.Row="1" Grid.Column="1" Text=""
                   FontSize="13" Height="20" VerticalAlignment="Center"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Loc Dialog.About.GitEngine}"
                   FontSize="13" Height="20" VerticalAlignment="Center"/>
        <TextBlock x:Name="gitEngine" Grid.Row="2" Grid.Column="1" Text=""
                   FontSize="13" Height="20" VerticalAlignment="Center"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Loc Dialog.About.GUI}"
                   FontSize="13" Height="20" VerticalAlignment="Center"/>
        <TextBlock x:Name="guiEngine" Grid.Row="3" Grid.Column="1" Text=""
                   FontSize="13" Height="20" VerticalAlignment="Center"/>
    </Grid>

    <Separator Grid.Row="6"/>

    <TextBlock x:Name="summaryFirst" Grid.Row="8" Text="{Loc Dialog.About.Summary.First}" FontSize="13"/>
    <TextBlock x:Name="summarySecond" Grid.Row="9" Text="{Loc Dialog.About.Summary.Second}" FontSize="13"/>

    <Grid Grid.Row="11">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26"/>
            <ColumnDefinition Width="84"/>
            <ColumnDefinition Width="86"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="92"/>
        </Grid.ColumnDefinitions>
        <Image x:Name="githubIcon" Grid.Column="0" VerticalAlignment="Center"/>
        <Button x:Name="github" Grid.Column="1" Height="24" FontSize="13" VerticalAlignment="Center"
                Content="{Loc Dialog.About.GitHub}"/>
        <Button x:Name="license" Grid.Column="2" Height="24" FontSize="13" VerticalAlignment="Center"
                Content="{Loc Dialog.About.License}"/>
        <Button x:Name="ok" Grid.Column="4" Height="32" VerticalAlignment="Center"
                Content="{Loc Dialog.About.OK}"/>
    </Grid>

    <TextBlock x:Name="copyright" Grid.Row="13" Text="" FontSize="11"/>
</Grid>
