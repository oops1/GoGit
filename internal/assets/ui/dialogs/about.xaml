<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="500" Height="365">

    <Grid.RowDefinitions>
        <RowDefinition Height="5"/>
        <RowDefinition Height="90"/>
        <RowDefinition Height="1"/>
        <RowDefinition Height="14"/>
        <RowDefinition Height="96"/>
        <RowDefinition Height="17"/>
        <RowDefinition Height="1"/>
        <RowDefinition Height="15"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="19"/>
        <RowDefinition Height="34"/>
        <RowDefinition Height="13"/>
        <RowDefinition Height="14"/>
        <RowDefinition Height="5"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Grid.RowSpan="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image x:Name="logo" Grid.Column="1" Height="80" Margin="0,2,0,0" VerticalAlignment="Top"/>
        <Grid Grid.Column="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="4"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="1" Text="{Loc App.Title}" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Top"/>
            <TextBlock x:Name="tagline" Grid.Row="2" Text="{Loc Dialog.About.Tagline}" FontSize="11"
                       VerticalAlignment="Top"/>
            <TextBlock x:Name="version" Grid.Row="3" Text="" FontSize="11"
                       VerticalAlignment="Top"/>
        </Grid>
    </Grid>

    <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
        </Grid.ColumnDefinitions>
        <Separator Grid.Column="1"/>
    </Grid>

    <Grid Grid.Row="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="platformLabel" Grid.Row="0" Grid.Column="1" Text="{Loc Dialog.About.Platform}"
                   FontSize="10" Height="20" VerticalAlignment="Center"/>
        <TextBlock x:Name="platform" Grid.Row="0" Grid.Column="2" Text=""
                   FontSize="10" Height="20" VerticalAlignment="Center"/>

        <TextBlock x:Name="architectureLabel" Grid.Row="1" Grid.Column="1" Text="{Loc Dialog.About.Architecture}"
                   FontSize="10" Height="20" VerticalAlignment="Center"/>
        <TextBlock x:Name="architecture" Grid.Row="1" Grid.Column="2" Text=""
                   FontSize="10" Height="20" VerticalAlignment="Center"/>

        <TextBlock x:Name="gitEngineLabel" Grid.Row="2" Grid.Column="1" Text="{Loc Dialog.About.GitEngine}"
                   FontSize="10" Height="20" VerticalAlignment="Center"/>
        <TextBlock x:Name="gitEngine" Grid.Row="2" Grid.Column="2" Text=""
                   FontSize="10" Height="20" VerticalAlignment="Center"/>

        <TextBlock x:Name="guiEngineLabel" Grid.Row="3" Grid.Column="1" Text="{Loc Dialog.About.GUI}"
                   FontSize="10" Height="20" VerticalAlignment="Center"/>
        <TextBlock x:Name="guiEngine" Grid.Row="3" Grid.Column="2" Text=""
                   FontSize="10" Height="20" VerticalAlignment="Center"/>
    </Grid>

    <Grid Grid.Row="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
        </Grid.ColumnDefinitions>
        <Separator Grid.Column="1"/>
    </Grid>

    <Grid Grid.Row="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="summaryFirst" Grid.Column="1" Text="{Loc Dialog.About.Summary.First}"
                   FontSize="10" VerticalAlignment="Center"/>
    </Grid>
    <Grid Grid.Row="9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="summarySecond" Grid.Column="1" Text="{Loc Dialog.About.Summary.Second}"
                   FontSize="10" VerticalAlignment="Center"/>
    </Grid>

    <Grid Grid.Row="11">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="96"/>
            <ColumnDefinition Width="24"/>
        </Grid.ColumnDefinitions>
        <Image x:Name="githubIcon" Grid.Column="1" VerticalAlignment="Center"/>
        <Button x:Name="github" Grid.Column="3" Height="24" FontSize="10" VerticalAlignment="Center"
                Content="{Loc Dialog.About.GitHub}"/>
        <Button x:Name="license" Grid.Column="5" Height="24" FontSize="10" VerticalAlignment="Center"
                Content="{Loc Dialog.About.License}"/>
        <Button x:Name="ok" Grid.Column="7" Height="34" FontSize="10" VerticalAlignment="Center"
                Content="{Loc Dialog.About.OK}"/>
    </Grid>

    <Grid Grid.Row="13">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="copyright" Grid.Column="1" Text="" FontSize="9"
                   VerticalAlignment="Center"/>
    </Grid>
</Grid>
