<?xml version="1.0" encoding="UTF-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="452" Height="252">

    <Grid.RowDefinitions>
        <RowDefinition Height="64"/>
        <RowDefinition Height="16"/>
        <RowDefinition Height="1"/>
        <RowDefinition Height="12"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="16"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="1"/>
        <RowDefinition Height="44"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="64"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="120"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="96"/>
        <ColumnDefinition Width="96"/>
    </Grid.ColumnDefinitions>

    <Image x:Name="logo" Grid.Row="0" Grid.Column="0"/>

    <Grid Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Loc App.Title}" FontSize="16" FontWeight="Bold"/>
        <TextBlock x:Name="tagline" Grid.Row="1" Text="{Loc Dialog.About.Tagline}" FontSize="11"/>
    </Grid>

    <Separator Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6"/>

    <Grid Grid.Row="4" Grid.RowSpan="5" Grid.Column="0" Grid.ColumnSpan="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Loc Dialog.About.Version}" FontSize="11"/>
        <TextBlock x:Name="version" Grid.Row="0" Grid.Column="1" Text="" FontSize="11"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Loc Dialog.About.Platform}" FontSize="11"/>
        <TextBlock x:Name="platform" Grid.Row="1" Grid.Column="1" Text="" FontSize="11"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Loc Dialog.About.Architecture}" FontSize="11"/>
        <TextBlock x:Name="architecture" Grid.Row="2" Grid.Column="1" Text="" FontSize="11"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Loc Dialog.About.GitEngine}" FontSize="11"/>
        <TextBlock x:Name="gitEngine" Grid.Row="3" Grid.Column="1" Text="" FontSize="11"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="{Loc Dialog.About.GUI}" FontSize="11"/>
        <TextBlock x:Name="guiEngine" Grid.Row="4" Grid.Column="1" Text="" FontSize="11"/>
    </Grid>

    <TextBlock x:Name="copyright" Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="6" Text="" FontSize="10"/>

    <Separator Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="6"/>

    <Grid Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="96"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="96"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="github" Grid.Column="0" Height="28" VerticalAlignment="Center"
                Content="{Loc Dialog.About.GitHub}"/>
        <Button x:Name="license" Grid.Column="2" Height="28" VerticalAlignment="Center"
                Content="{Loc Dialog.About.License}"/>
        <Button x:Name="ok" Grid.Column="4" Tag="accent" Height="28" VerticalAlignment="Center"
                Content="{Loc Dialog.About.OK}"/>
    </Grid>
</Grid>
