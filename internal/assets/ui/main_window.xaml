<?xml version="1.0" encoding="UTF-8"?>
<Window x:Class="GoGit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="mainWindow"
        Title="{Loc App.Title}"
        Width="1280" Height="800"
        MinWidth="1280" MinHeight="760"
        ShowLocaleIndicator="False">

    <DockPanel>

        <Menu x:Name="mainMenu" DockPanel.Dock="Top">
            <MenuItem Header="{Loc Menu.Repository}">
                <MenuItem Header="{Loc Menu.Repository.AddOrCreate}"/>
                <MenuItem Header="{Loc Menu.Repository.AddGroup}"/>
                <MenuItem Header="{Loc Menu.Repository.Clone}"/>
                <MenuItem Header="{Loc Menu.Repository.Search}"/>
                <MenuItem Header="{Loc Menu.Repository.CloseRepository}" IsEnabled="False"/>
                <MenuItem Separator="True"/>
                <MenuItem Header="{Loc Menu.Repository.AddWorktree}" IsEnabled="False"/>
                <MenuItem Header="{Loc Menu.Repository.RemoveWorktree}" IsEnabled="False"/>
                <MenuItem Header="{Loc Menu.Repository.PruneWorktrees}" IsEnabled="False"/>
                <MenuItem Separator="True"/>
                <MenuItem Header="{Loc Menu.Repository.SparseCheckout}" IsEnabled="False"/>
                <MenuItem Separator="True"/>
                <MenuItem Header="{Loc Menu.Repository.RepoSettings}" IsEnabled="False"/>
                <MenuItem Header="{Loc Menu.Repository.Close}"/>
            </MenuItem>
            <MenuItem Header="{Loc Menu.Edit}">
                <MenuItem Header="{Loc Menu.Edit.Copy}" IsEnabled="False"/>
                <MenuItem Header="{Loc Menu.Edit.SelectAll}" IsEnabled="False"/>
                <MenuItem Separator="True"/>
                <MenuItem Header="{Loc Menu.Edit.Preferences}"/>
            </MenuItem>
            <MenuItem Header="{Loc Menu.View}">
                <MenuItem Header="{Loc Menu.View.Theme}">
                    <MenuItem Header="{Loc Theme.System}"/>
                    <MenuItem Header="{Loc Theme.Dark}"/>
                    <MenuItem Header="{Loc Theme.Light}"/>
                </MenuItem>
                <MenuItem Header="{Loc Menu.View.Language}">
                    <MenuItem Header="{Loc Language.en}"/>
                    <MenuItem Header="{Loc Language.ru}"/>
                </MenuItem>
                <MenuItem Separator="True"/>
                <MenuItem Header="{Loc Menu.View.Refresh}"/>
            </MenuItem>
            <MenuItem Header="{Loc Menu.Remote}">
                <MenuItem Header="{Loc Menu.Remote.Fetch}" IsEnabled="False"/>
                <MenuItem Header="{Loc Menu.Remote.Pull}" IsEnabled="False"/>
                <MenuItem Header="{Loc Menu.Remote.Push}" IsEnabled="False"/>
                <MenuItem Header="{Loc Menu.Remote.Sync}" IsEnabled="False"/>
                <MenuItem Separator="True"/>
                <MenuItem Header="{Loc Menu.Remote.Prune}" IsEnabled="False"/>
                <MenuItem Separator="True"/>
                <MenuItem Header="{Loc Menu.Remote.Manage}" IsEnabled="False"/>
                <MenuItem Separator="True"/>
                <MenuItem Header="{Loc Menu.Remote.Submodule}">
                    <MenuItem Header="{Loc Menu.Remote.Submodule.Update}" IsEnabled="False"/>
                    <MenuItem Header="{Loc Menu.Remote.Submodule.Initialize}" IsEnabled="False"/>
                    <MenuItem Header="{Loc Menu.Remote.Submodule.Synchronize}" IsEnabled="False"/>
                    <MenuItem Separator="True"/>
                    <MenuItem Header="{Loc Menu.Remote.Submodule.Add}" IsEnabled="False"/>
                    <MenuItem Header="{Loc Menu.Remote.Submodule.Remove}" IsEnabled="False"/>
                    <MenuItem Header="{Loc Menu.Remote.Submodule.Unregister}" IsEnabled="False"/>
                    <MenuItem Header="{Loc Menu.Remote.Submodule.Reset}" IsEnabled="False"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{Loc Menu.Local}">
                <MenuItem Header="{Loc Menu.Local.Commit}" IsEnabled="False"/>
                <MenuItem Separator="True"/>
                <MenuItem Header="{Loc Menu.Local.Stage}" IsEnabled="False"/>
                <MenuItem Header="{Loc Menu.Local.Unstage}" IsEnabled="False"/>
                <MenuItem Header="{Loc Menu.Local.Discard}" IsEnabled="False"/>
                <MenuItem Header="{Loc Menu.Files.IndexEditor}" IsEnabled="False"/>
                <MenuItem Separator="True"/>
                <MenuItem Header="{Loc Menu.Local.SaveStash}" IsEnabled="False"/>
                <MenuItem Header="{Loc Menu.Local.ApplyStash}" IsEnabled="False"/>
                <MenuItem Header="{Loc Menu.Local.DropStash}" IsEnabled="False"/>
                <MenuItem Separator="True"/>
                <MenuItem Header="{Loc Menu.Files.Ignore}" IsEnabled="False"/>
                <MenuItem Header="{Loc Menu.Files.Remove}" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="{Loc Menu.Branch}">
                <MenuItem Header="{Loc Menu.Branch.Switch}" IsEnabled="False"/>
                <MenuItem Separator="True"/>
                <MenuItem Header="{Loc Menu.Branch.Merge}" IsEnabled="False"/>
                <MenuItem Header="{Loc Menu.Branch.Rebase}" IsEnabled="False"/>
                <MenuItem Header="{Loc Menu.Branch.RebaseInteractive}" IsEnabled="False"/>
                <MenuItem Separator="True"/>
                <MenuItem Header="{Loc Menu.Branch.Continue}" IsEnabled="False"/>
                <MenuItem Header="{Loc Menu.Branch.Skip}" IsEnabled="False"/>
                <MenuItem Header="{Loc Menu.Branch.AbortMerge}" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="{Loc Menu.Query}">
                <MenuItem Header="{Loc Menu.Query.Log}" IsEnabled="False"/>
                <MenuItem Header="{Loc Menu.Context.Blame}" IsEnabled="False"/>
                <MenuItem Header="{Loc Menu.Files.Investigate}" IsEnabled="False"/>
                <MenuItem Separator="True"/>
                <MenuItem Header="{Loc Menu.Query.CompareFiles}"/>
                <MenuItem Header="{Loc Menu.Query.CompareBranches}" IsEnabled="False"/>
                <MenuItem Separator="True"/>
                <MenuItem Header="{Loc Menu.Query.Reflog}" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="{Loc Menu.Tools}">
                <MenuItem Header="{Loc Menu.Tools.GitFlow}">
                    <MenuItem Header="{Loc Menu.Tools.GitFlow.StartFeature}" IsEnabled="False"/>
                    <MenuItem Header="{Loc Menu.Tools.GitFlow.IntegrateDevelop}" IsEnabled="False"/>
                    <MenuItem Header="{Loc Menu.Tools.GitFlow.FinishFeature}" IsEnabled="False"/>
                    <MenuItem Separator="True"/>
                    <MenuItem Header="{Loc Menu.Tools.GitFlow.StartHotfix}" IsEnabled="False"/>
                    <MenuItem Header="{Loc Menu.Tools.GitFlow.FinishHotfix}" IsEnabled="False"/>
                    <MenuItem Separator="True"/>
                    <MenuItem Header="{Loc Menu.Tools.GitFlow.StartRelease}" IsEnabled="False"/>
                    <MenuItem Header="{Loc Menu.Tools.GitFlow.FinishRelease}" IsEnabled="False"/>
                    <MenuItem Separator="True"/>
                    <MenuItem Header="{Loc Menu.Tools.GitFlow.StartSupport}" IsEnabled="False"/>
                    <MenuItem Separator="True"/>
                    <MenuItem Header="{Loc Menu.Tools.GitFlow.Configure}" IsEnabled="False"/>
                </MenuItem>
                <MenuItem Separator="True"/>
                <MenuItem Header="{Loc Menu.Tools.Maintenance}">
                    <MenuItem Header="{Loc Menu.Tools.Maintenance.Gc}" IsEnabled="False"/>
                    <MenuItem Header="{Loc Menu.Tools.Maintenance.Fsck}" IsEnabled="False"/>
                </MenuItem>
                <MenuItem Separator="True"/>
                <MenuItem Header="{Loc Menu.Context.Reveal}" IsEnabled="False"/>
                <MenuItem Header="{Loc Menu.Context.Terminal}" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="{Loc Menu.Window}">
                <MenuItem Header="{Loc Menu.Window.Panes}">
                    <MenuItem Header="{Loc Pane.Repositories}"/>
                    <MenuItem Header="{Loc Pane.Branches}"/>
                    <MenuItem Header="{Loc Pane.Files}"/>
                    <MenuItem Header="{Loc Pane.Journal}"/>
                </MenuItem>
                <MenuItem Header="{Loc Menu.Window.ResetLayout}"/>
                <MenuItem Header="{Loc Menu.Window.ConfigureToolbar}"/>
                <MenuItem Separator="True"/>
                <MenuItem Header="{Loc Menu.Window.Layout}">
                    <MenuItem Header="{Loc Layout.Docks}"/>
                    <MenuItem Header="{Loc Layout.Sidebar}"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{Loc Menu.Help}">
                <MenuItem Header="{Loc Menu.Help.CheckUpdates}"/>
                <MenuItem Separator="True"/>
                <MenuItem Header="{Loc Menu.Help.About}"/>
            </MenuItem>
        </Menu>

        <Grid x:Name="mainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="toolbar" Grid.Row="0" Orientation="Horizontal" Margin="4"
                        Background="{Theme PanelBG}"/>

            <DockManager x:Name="dock" Grid.Row="1" NativeFloating="True">
                <DockPane Id="repositories" Title="{Loc Pane.Repositories}" Side="Left" Size="260">
                    <TreeView x:Name="reposTree" ShowIndentGuides="True"/>
                </DockPane>
                <DockPane Id="branches" Title="{Loc Pane.Branches}" Side="Left" Size="260">
                    <TreeView x:Name="branchesTree" ShowIndentGuides="True"/>
                </DockPane>
                <DockPane Id="files" Title="{Loc Pane.Files}" Side="Top" Size="200">
                    <DockPanel>
                        <DockPanel x:Name="mergeBanner" DockPanel.Dock="Top" Margin="4,4,4,0" Visibility="Collapsed">
                            <Button x:Name="mergeBannerAbort" DockPanel.Dock="Right" Height="24" Margin="6,0,0,0"
                                    Content="{Loc Banner.Merge.Abort}"/>
                            <Button x:Name="mergeBannerCommit" DockPanel.Dock="Right" Height="24" Margin="6,0,0,0"
                                    Content="{Loc Banner.Merge.Commit}"/>
                            <TextBlock x:Name="mergeBannerText" Text="" Margin="6,4,0,4" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <DockPanel x:Name="filesFilterRow" DockPanel.Dock="Top" Margin="4,4,4,2">
                            <TextBox x:Name="filesFilter" DockPanel.Dock="Left" Width="150" Margin="0,0,6,0"
                                     Placeholder="{Loc Files.Filter.Placeholder}"/>
                            <Button x:Name="filesFilterSubdirs" DockPanel.Dock="Left" Width="26" Height="24" Margin="0,0,6,0"/>
                            <Button x:Name="filesWorkingCopy" DockPanel.Dock="Left" Height="24" Margin="0,0,6,0"
                                    Visibility="Collapsed" Content="{Loc Files.BackToWorkingCopy}"/>
                            <StackPanel x:Name="filesFilterButtons" DockPanel.Dock="Right"
                                        Orientation="Horizontal" Width="270">
                                <Button x:Name="filesFilterStaged" Width="26" Height="24" Margin="2,0"/>
                                <Button x:Name="filesFilterModified" Width="26" Height="24" Margin="2,0"/>
                                <Button x:Name="filesFilterAdded" Width="26" Height="24" Margin="2,0"/>
                                <Button x:Name="filesFilterDeleted" Width="26" Height="24" Margin="2,0"/>
                                <Button x:Name="filesFilterRenamed" Width="26" Height="24" Margin="2,0"/>
                                <Button x:Name="filesFilterUntracked" Width="26" Height="24" Margin="2,0"/>
                                <Button x:Name="filesFilterIgnored" Width="26" Height="24" Margin="2,0"/>
                                <Button x:Name="filesFilterConflict" Width="26" Height="24" Margin="2,0"/>
                                <Button x:Name="filesFilterUnchanged" Width="26" Height="24" Margin="2,0"/>
                            </StackPanel>
                            <TextBlock x:Name="filesFilterCount" DockPanel.Dock="Right" Text="" Width="70"
                                       FontSize="9" Margin="0,4,10,4"/>
                        </DockPanel>
                        <FilesGrid x:Name="filesGrid"/>
                    </DockPanel>
                </DockPane>
                <DockPane Id="journal" Title="{Loc Pane.Journal}" Side="Bottom" Size="220">
                    <DockPanel LastChildFill="True">
                        <DockPanel x:Name="journalFilterRow" DockPanel.Dock="Top" Height="28" LastChildFill="True">
                            <TextBlock x:Name="journalFilterBranchLabel" DockPanel.Dock="Left" Text="{Loc Journal.Filter.Branch}"
                                       FontSize="9" Margin="8,6,4,4"/>
                            <ComboBox x:Name="journalFilterBranch" DockPanel.Dock="Left" Width="160" Height="24" Margin="0,2,6,2"/>
                            <TextBlock x:Name="journalFilterAuthorLabel" DockPanel.Dock="Left" Text="{Loc Journal.Filter.Author}"
                                       FontSize="9" Margin="0,6,4,4"/>
                            <TextBox x:Name="journalFilterAuthor" DockPanel.Dock="Left" Width="140" Height="24" Margin="0,2,6,2"/>
                            <TextBlock x:Name="journalFilterCount" DockPanel.Dock="Right" Text="" Width="110"
                                       FontSize="9" Margin="0,6,10,4"/>
                            <TextBox x:Name="journalFilterMessage" Height="24" Margin="0,2,6,2"/>
                        </DockPanel>
                        <DockPanel x:Name="journalSearchRow" DockPanel.Dock="Top" Height="28" LastChildFill="True">
                            <TextBox x:Name="journalFilterPath" DockPanel.Dock="Left" Width="170" Height="24" Margin="8,2,6,2"
                                     Placeholder="{Loc Journal.Filter.PathHint}"/>
                            <ComboBox x:Name="journalFilterPeriod" DockPanel.Dock="Right" Width="110" Height="24" Margin="0,2,10,2"/>
                            <TextBlock x:Name="journalFilterPeriodLabel" DockPanel.Dock="Right" Text="{Loc Journal.Filter.Period}"
                                       FontSize="9" Margin="0,6,4,4"/>
                            <CheckBox x:Name="journalFilterRegexp" DockPanel.Dock="Right" Margin="0,6,12,4"
                                      Content="{Loc Journal.Filter.Regexp}"/>
                            <TextBox x:Name="journalFilterContent" Height="24" Margin="0,2,6,2"
                                     Placeholder="{Loc Journal.Filter.ContentHint}"/>
                        </DockPanel>
                        <DataGrid x:Name="journalGrid" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="" Binding="{Binding Graph}" Width="60"/>
                            <DataGridTextColumn Header="" Binding="{Binding Message}" Width="*"/>
                            <DataGridTextColumn Header="" Binding="{Binding Author}" Width="160"/>
                            <DataGridTextColumn Header="" Binding="{Binding Date}" Width="140"/>
                            <DataGridTextColumn Header="" Binding="{Binding ShortHash}" Width="90"/>
                        </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </DockPane>
                <DockPane Id="details" Title="{Loc Pane.Details}" Side="Right" Size="320">
                    <TabControl x:Name="detailsTabs"/>
                </DockPane>
                <DockContent>
                    <GitDiffView x:Name="diffView"/>
                </DockContent>
            </DockManager>

            <Grid x:Name="statusBar" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="statusText" Grid.Column="0" Text="{Loc Status.Ready}" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                <Rectangle Grid.Column="1" Fill="#40808080"/>
                <TextBlock x:Name="statusBranch" Grid.Column="2" Text="" Margin="8,0" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                <Rectangle Grid.Column="3" Fill="#40808080" Visibility="Collapsed"/>
                <ProgressBar x:Name="statusProgress" Grid.Column="4" Value="0" Margin="8,4" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
