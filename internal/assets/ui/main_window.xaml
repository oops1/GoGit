<?xml version="1.0" encoding="UTF-8"?>
<Window x:Class="GoGit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="mainWindow"
        Title="Go.Git"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="600"
        ShowLocaleIndicator="False">

    <DockPanel>

        <Menu x:Name="mainMenu" DockPanel.Dock="Top">
            <MenuItem Header="{Loc Menu.Repository}">
                <MenuItem Header="{Loc Menu.Repository.AddOrCreate}"/>
                <MenuItem Header="{Loc Menu.Repository.AddGroup}"/>
                <MenuItem Header="{Loc Menu.Repository.Search}"/>
                <MenuItem Header="{Loc Menu.Repository.CloseRepository}" IsEnabled="False"/>
                <MenuItem Separator="True"/>
                <MenuItem Header="{Loc Menu.Repository.AddWorktree}" IsEnabled="False"/>
                <MenuItem Header="{Loc Menu.Repository.RemoveWorktree}" IsEnabled="False"/>
                <MenuItem Header="{Loc Menu.Repository.PruneWorktrees}" IsEnabled="False"/>
                <MenuItem Separator="True"/>
                <MenuItem Header="{Loc Menu.Repository.Settings}"/>
                <MenuItem Header="{Loc Menu.Repository.Close}"/>
            </MenuItem>
            <MenuItem Header="{Loc Menu.View}">
                <MenuItem Header="{Loc Menu.View.Panes}">
                    <MenuItem Header="{Loc Pane.Repositories}"/>
                    <MenuItem Header="{Loc Pane.Branches}"/>
                    <MenuItem Header="{Loc Pane.Files}"/>
                    <MenuItem Header="{Loc Pane.Journal}"/>
                </MenuItem>
                <MenuItem Header="{Loc Menu.View.ResetLayout}"/>
                <MenuItem Separator="True"/>
                <MenuItem Header="{Loc Menu.View.Theme}">
                    <MenuItem Header="{Loc Theme.System}"/>
                    <MenuItem Header="{Loc Theme.Dark}"/>
                    <MenuItem Header="{Loc Theme.Light}"/>
                </MenuItem>
                <MenuItem Header="{Loc Menu.View.Language}">
                    <MenuItem Header="{Loc Language.en}"/>
                    <MenuItem Header="{Loc Language.ru}"/>
                </MenuItem>
                <MenuItem Separator="True"/>
                <MenuItem Header="{Loc Menu.View.Refresh}"/>
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="toolbar" Grid.Row="0" Orientation="Horizontal" Margin="4">
                <Button x:Name="btnPull" Content="{Loc Toolbar.Pull}" ToolTip="{Loc Toolbar.Pull.Tip}" Margin="2" IsEnabled="False"/>
                <Button x:Name="btnSync" Content="{Loc Toolbar.Sync}" ToolTip="{Loc Toolbar.Sync.Tip}" Margin="2" IsEnabled="False"/>
                <Button x:Name="btnPush" Content="{Loc Toolbar.Push}" ToolTip="{Loc Toolbar.Push.Tip}" Margin="2" IsEnabled="False"/>
                <Separator x:Name="toolbarSep1" Width="8" Height="24" Margin="4,0"/>
                <Button x:Name="btnCommit" Content="{Loc Toolbar.Commit}" ToolTip="{Loc Toolbar.Commit.Tip}" Margin="2" IsEnabled="False"/>
            </StackPanel>

            <DockManager x:Name="dock" Grid.Row="1" NativeFloating="True">
                <DockPane Id="repositories" Title="{Loc Pane.Repositories}" Side="Left" Size="260">
                    <TreeView x:Name="reposTree" ShowIndentGuides="True"/>
                </DockPane>
                <DockPane Id="branches" Title="{Loc Pane.Branches}" Side="Left" Size="260">
                    <TreeView x:Name="branchesTree" ShowIndentGuides="True"/>
                </DockPane>
                <DockPane Id="files" Title="{Loc Pane.Files}" Side="Top" Size="200">
                    <DataGrid x:Name="filesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Loc Files.Column.Status}" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="{Loc Files.Column.Name}" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="{Loc Files.Column.Path}" Binding="{Binding Path}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPane>
                <DockPane Id="journal" Title="{Loc Pane.Journal}" Side="Bottom" Size="220">
                    <DataGrid x:Name="journalGrid" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Loc Journal.Column.Graph}" Binding="{Binding Graph}" Width="60"/>
                            <DataGridTextColumn Header="{Loc Journal.Column.Message}" Binding="{Binding Message}" Width="*"/>
                            <DataGridTextColumn Header="{Loc Journal.Column.Author}" Binding="{Binding Author}" Width="160"/>
                            <DataGridTextColumn Header="{Loc Journal.Column.Date}" Binding="{Binding Date}" Width="140"/>
                            <DataGridTextColumn Header="{Loc Journal.Column.Hash}" Binding="{Binding ShortHash}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPane>
                <DockContent>
                    <DiffView x:Name="diffView" Mode="SideBySide" FontFamily="Consolas"/>
                </DockContent>
            </DockManager>

            <Grid x:Name="statusBar" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="statusText" Grid.Column="0" Text="{Loc Status.Ready}" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                <Rectangle Grid.Column="1" Fill="#40808080"/>
                <TextBlock x:Name="statusBranch" Grid.Column="2" Text="" Margin="8,0" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                <Rectangle Grid.Column="3" Fill="#40808080"/>
                <ProgressBar x:Name="statusProgress" Grid.Column="4" Value="0" Margin="8,4" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
